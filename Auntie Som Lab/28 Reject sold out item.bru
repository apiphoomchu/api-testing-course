meta {
  name: Reject sold out item
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {"itemId":2,"quantity":1}
}

script:pre-request {
  bru.setEnvVar("expectedStock1", Number(bru.getEnvVar("stock1")));
  bru.setEnvVar("expectedStock2", Number(bru.getEnvVar("stock2")));
}

tests {
  test("Sold out item is rejected", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Sold out response explains the problem", function () {
    expect(res.getBody().error).to.equal("Out of stock");
  });
}
