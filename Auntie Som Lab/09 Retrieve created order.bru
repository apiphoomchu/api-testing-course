meta {
  name: Retrieve created order
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Created order is retrievable", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Retrieved order has the saved ID and status", function () {
    expect(res.getBody().orderId).to.equal(bru.getEnvVar("orderId"));
    expect(res.getBody().status).to.equal("created");
  });
  test("Stored total is also correct", function () {
    expect(res.getBody().totalPrice).to.equal(Number(bru.getEnvVar("price1")));
  });
}
