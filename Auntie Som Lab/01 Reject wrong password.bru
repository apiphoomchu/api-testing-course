meta {
  name: Reject wrong password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"username":"student","password":"wrong"}
}

tests {
  test("Wrong password is rejected", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
